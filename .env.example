# ============================================================
# EHR-MX Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://ehr:secret@localhost:5432/ehr_dev
# For direct connections (Prisma migrations)
DIRECT_DATABASE_URL=postgresql://ehr:secret@localhost:5432/ehr_dev

# --- Redis ---
REDIS_URL=redis://:secret@localhost:6379

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ehr-dev
KEYCLOAK_CLIENT_ID=ehr-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# --- NestJS API ---
API_PORT=3001
NODE_ENV=development

# --- Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# OIDC / Keycloak for Next.js auth
KEYCLOAK_ISSUER=http://localhost:8080/realms/ehr-dev
KEYCLOAK_CLIENT_ID_WEB=ehr-web
